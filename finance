function loadQuizBank(){
    const str = localStorage.getItem(STORAGE_KEY_QUIZ_BANK);
    if(str){
        return JSON.parse(str);
    }else{
        return baseQuizBank;
    }
}
function saveQuizBank(bankArr){
    localStorage.setItem(STORAGE_KEY_QUIZ_BANK, JSON.stringify(bankArr));
}
let totalQuizBank = loadQuizBank();

document.getElementById("btnUploadQuiz").onclick = ()=>{
    document.getElementById("fileQuizUpload").click();
}
document.getElementById("fileQuizUpload").onchange = function(e){
    const f = e.target.files[0];
    if(!f) return;
    const msgDom = document.getElementById("simAiQuizMsg");
    const reader = new FileReader();
    reader.onload = function(ev){
        try{
            const userImport = JSON.parse(ev.target.result);
            if(!Array.isArray(userImport)) throw new Error("不是数组");
            const validItems = [];
            for(let item of userImport){
                if(item.course && item.q && Array.isArray(item.opts) && typeof item.ans === "number"){
                    validItems.push(item);
                }
            }
            if(validItems.length === 0){
                msgDom.innerText="解析完成，没有识别合法题目，请检查JSON字段";
                return;
            }
            totalQuizBank = [...totalQuizBank, ...validItems];
            saveQuizBank(totalQuizBank);
            msgDom.innerText=`✅解析完成！导入${validItems.length}道题目，归入对应课程总题库，当前总题库：${totalQuizBank.length}题`;
        }catch(err){
            msgDom.innerText="解析JSON失败，请检查文件格式";
        }
    }
    reader.readAsText(f);
}

document.getElementById("btnSimGenQuiz").onclick = ()=>{
