    URL.revokeObjectURL(url);
}

function getFilterQuizList(selectedCourse){
    if(selectedCourse === "all"){
        return [...totalQuizBank];
    }else{
        return totalQuizBank.filter(item=>item.course === selectedCourse);
    }
}

function shuffle(arr){
    let tmp = [...arr];
    for(let i=tmp.length-1;i>0;i--){
        const j = Math.floor(Math.random()*(i+1));
        [tmp[i],tmp[j]] = [tmp[j],tmp[i]];
    }
    return tmp;
}

let quizSession = {
    started:false,
    pool:[],
    currentIdx:0,
    userAnswers:[],
    correctCount:0,
    scoreList:[]
};

function renderQuizItem(){
    if(!quizSession.started)return;
    const idx = quizSession.currentIdx;
    if(idx>=quizSession.pool.length){
        document.getElementById("quizBox").innerText="全部题目完成，请点击交卷评分";
        return;
    }
    const item = quizSession.pool[idx];
    const box = document.getElementById("quizBox");
    let html = `<div><b>${idx+1}.【${item.course}】${item.q}</b></div>`;
    item.opts.forEach((opt,i)=>{
        html+=`<div class="option" onclick="selectAns(${i})">${opt}</div>`;
    })
    box.innerHTML = html;
}
window.selectAns = function(optIdx){
    if(!quizSession.started)return;
    const cur = quizSession.pool[quizSession.currentIdx];
    const isRight = optIdx === cur.ans;
    quizSession.userAnswers.push({qIdx:quizSession.currentIdx,sel:optIdx,correct:isRight});
    if(isRight) quizSession.correctCount++;
    const instantScore = Math.round( (quizSession.correctCount / (quizSession.userAnswers.length))*100 );
    quizSession.scoreList.push(instantScore);
    quizSession.currentIdx++;
    renderQuizItem();
}

document.getElementById("btnStartQuiz").onclick = ()=>{
    const selCourse = document.getElementById("selectCourse").value;
    const sourceList = getFilterQuizList(selCourse);
    if(sourceList.length===0){
        alert(`【${selCourse}】课程题库为空，请导入该课程题库！`);
        return;
    }
    // 修改：随机抽取5题
    quizSession = {
        started:true,
        pool:shuffle(sourceList).slice(0,5),
        currentIdx:0,
        userAnswers:[],
        correctCount:0,
        scoreList:[]
    };
    document.getElementById("reportBox").style.display="none";
    document.getElementById("errorAnalysisBox").style.display="none";
    renderQuizItem();
}

document.getElementById("btnSubmit").onclick = ()=>{
    if(!quizSession.started){alert("请先开始测验");return;}
    const total = quizSession.pool.length;
    const right = quizSession.correctCount;
    const finalScore = Math.round(right/total*100);
    lastQuizFinalScore = finalScore;
    const reportDom = document.getElementById("reportBox");
    reportDom.style.display="block";
    reportDom.innerHTML = `
    <div>📝交卷报告</div>
    <div>总题数：${total}｜答对：${right}｜综合掌握得分：${finalScore}</div>
    <div>说明：点击【生成本日学情记录】自动写入学情K线；点击【查看错题解析】看错题知识点解析</div>
    `;
}

document.getElementById("btnShowError").onclick = ()=>{
    if(!quizSession.started || quizSession.userAnswers.length===0){
        alert("请先完成测验交卷");
        return;
    }
    const errBox = document.getElementById("errorAnalysisBox");
    errBox.style.display="block";
    let htmlText = "=====错题解析=====\n";
    quizSession.userAnswers.forEach(ua=>{
        if(!ua.correct){
            const qItem = quizSession.pool[ua.qIdx];
            htmlText+=`题干：${qItem.q}\n正确答案：${qItem.opts[qItem.ans]}\n解析：${qItem.analysis||"无解析"}\n----------------\n`;
        }
    })
    errBox.innerText = htmlText;
}

document.getElementById("btnGenRecord").onclick = ()=>{
    if(!quizSession.started || quizSession.scoreList.length===0){
        alert("完成测验并且交卷后，再生成学情记录");
        return;
    }
    const scores = quizSession.scoreList;
    const o = scores[0];
    const h = Math.max(...scores);
    const l = Math.min(...scores);
    const total = quizSession.pool.length;
    const c = Math.round(quizSession.correctCount/total*100);
    const today = new Date().toISOString().slice(0,10);
    const newRec = [today,o,h,l,c];
    studyRecords.push(newRec);
    saveStudyLocal(studyRecords);
    renderList();
    renderChart();
    alert(`✅已生成今日学情记录：预习${o}，峰值${h}，薄弱${l}，课后掌握${c}`);
}

