<script>
const myChart = echarts.init(document.getElementById('chart'));
const STORAGE_KEY_STUDY = "finance_study_kline";
const STORAGE_KEY_QUIZ_BANK = "finance_total_quiz_bank";

// =====================【手写离线简易智能体核心模块】=====================
/**
 * 离线规则驱动简易智能体
 * 能力：1.关键词匹配知识问答 2.文本模板出题 3.统计学情输出分层学习建议
 * 完全JS实现，无网络，不调用任何外部API
 */
const OfflineAgent = {
    knowledge:[
        {
            keywords:["mm理论","mm","资本结构","税盾"],
            answer:"MM资本结构理论分为无税MM、有税MM两个版本。\n1.无税MM理论：企业资本结构不会改变企业总价值；\n2.有税MM理论：债务利息可以税前抵扣，产生利息税盾，负债越高企业价值越大。\n是公司金融资本结构章节核心理论。"
        },
        {
            keywords:["capm","资本资产定价","贝塔","β","系统风险"],
            answer:"CAPM资本资产定价模型公式：Ri = Rf + β(Rm‑Rf)\n• Rf：无风险收益率\n• β：系统风险系数，β>1波动大于市场；β=1和市场一致；β<1波动小于市场\n• Rm‑Rf：市场风险溢价\n用于股权资本成本估算，投资学核心模型。"
        },
        {
            keywords:["有效市场假说","emh","弱式","半强式","强式"],
            answer:"有效市场假说EMH：\n1.弱式有效：历史价格信息全部反映在股价，技术分析无效；\n2.半强式有效：所有公开信息全部反映，基本面分析无法获取超额收益；\n3.强式有效：连内幕信息都已经反映在价格。"
        },
        {
            keywords:["市盈率","pe","估值"],
            answer:"市盈率 PE = 股价 / 每股收益。\n衡量市场对企业盈利的估值水平；适合盈利稳定企业；亏损企业PE指标没有参考意义。"
        },
        {
            keywords:["巴塞尔协议","资本充足率","商业银行"],
            answer:"巴塞尔协议核心：监管商业银行资本充足率，约束信用风险，防范银行破产风险。对银行资本金计提、风险加权资产做严格规定。"
        },
        {
            keywords:["公开市场操作","货币政策","央行买卖债券"],
            answer:"公开市场操作是央行货币政策工具。买入债券投放基础货币，市场流动性扩张；卖出债券回收基础货币，收紧市场流动性。"
        }
    ],

    chat(userInput){
        const input = userInput.toLowerCase();
        let maxHit = 0;
        let bestAns = null;
        for(let item of this.knowledge){
            let hitCount = 0;
            for(let kw of item.keywords){
                if(input.includes(kw)) hitCount++;
            }
            if(hitCount>0 && hitCount>maxHit){
                maxHit = hitCount;
                bestAns = item.answer;
            }
        }
        if(bestAns){
            return bestAns;
        }else{
            return "【离线规则智能体】未匹配知识库中的知识点。\n本版本基于关键词匹配实现，无大模型泛化能力。\n可提问关键词：MM理论、CAPM、有效市场假说、市盈率PE、巴塞尔协议、公开市场操作。";
        }
    },

    generateQuizByText(text){
        const words = text.match(/[\u4e00‑\u9fa5]{2,10}/g) || [];
        const pick = words.length>0 ? words[0] : "金融学核心概念";
        return {
            course:"货币银行学",
            q:`关于【${pick}】，下面表述正确的是？`,
            opts:[
                `A、${pick}的正确理论描述（模板生成）`,
                `B、对${pick}的错误理解一`,
                `C、对${pick}的错误理解二`,
                `D、对${pick}的错误理解三`
            ],
            ans:0,
            tag:"离线智能体模板生成题目",
            analysis:"【模板解析】本题由离线智能体模板生成，实际使用需要完善解析内容。"
        }
    },

    analysisStudy(studyRecords, lastScore){
        if(!studyRecords || studyRecords.length===0){
            return "暂无任何学习学情记录，请完成测验生成学情记录。";
        }
        const closeArr = studyRecords.map(i=>i[4]);
        const avgScore = closeArr.reduce((s,v)=>s+v,0)/closeArr.length;
        const maxScore = Math.max(...closeArr);
        const minScore = Math.min(...closeArr);

        let levelTip = "";
        if(avgScore >=80){
            levelTip = "整体掌握水平优秀，知识点基础牢固，可以训练难度更高题目，拓展案例分析。";
        }else if(avgScore >=60){
            levelTip = "处于中等掌握水平，存在部分知识盲区，建议针对错题对应的知识点回看教材，专项刷题。";
        }else{
            levelTip = "整体掌握偏弱，优先回归教材基础概念，不要刷难题，夯实基础。";
        }

        let trendTip = "";
        if(lastScore!==null){
            if(lastScore>avgScore){
                trendTip = `本次测验得分${lastScore}，高于历史平均${avgScore.toFixed(1)}，本次学习效果不错。`
            }else{
                trendTip = `本次测验得分${lastScore}，低于历史平均${avgScore.toFixed(1)}，需要复盘本次错题。`
            }
        }

        return `===== 🧠离线智能体学情分析报告 =====
> 说明：基于统计学情K线数据+条件分支模板生成，非大模型语义理解

📊统计指标
学习记录总天数：${studyRecords.length}天
历史平均课后掌握度：${avgScore.toFixed(1)}
历史最高掌握度：${maxScore}
历史最低掌握度：${minScore}

💡学习诊断
${levelTip}
${trendTip}

📌行动建议
1、针对测验错题，阅读对应知识点解析；
2、最低掌握度较低的日期，代表当天存在明显知识漏洞，回看课程；
3、坚持分课程专项刷题，逐个攻克课程薄弱章节。`
    }
};
// =====================智能体模块结束=====================

// -------------------------- 1、学情K线部分 --------------------------
function loadStudyLocal(){
    const str = localStorage.getItem(STORAGE_KEY_STUDY);
    if(str) return JSON.parse(str);
    return [
        ["2026-10-01",45,72,30,60],
        ["2026-10-02",62,80,44,71],
        ["2026-10-03",58,75,35,65],
        ["2026-10-04",66,88,50,79],
        ["2026-10-05",70,90,55,82]
    ];
}
function saveStudyLocal(arr){
    localStorage.setItem(STORAGE_KEY_STUDY, JSON.stringify(arr));
}
let studyRecords = loadStudyLocal();
let lastQuizFinalScore = null;

function getStudyPredict(records){
    if(!records||records.length===0) return [];
    const lastDate = new Date(records[records.length-1][0]);
    const lastClose = records[records.length-1][4];
    let pred = [];
    for(let i=1;i<=3;i++){
        const d = new Date(lastDate);
        d.setDate(d.getDate()+i);
        const ds = d.toISOString().slice(0,10);
        const delta = (Math.random()-0.5)*12;
        const val = Math.max(0,Math.min(100, Number((lastClose+delta).toFixed(1))));
        pred.push([ds, val]);
    }
    return pred;
}

function renderList(){
    const dom = document.getElementById("dataList");
    dom.innerHTML = "";
    studyRecords.forEach((r,idx)=>{
        const div = document.createElement("div");
        div.className = "item";
        div.innerHTML = `<span>${r[0]}｜预习:${r[1]} 峰值:${r[2]} 薄弱:${r[3]} 课后掌握:${r[4]}</span>
        <button class="del" onclick="delItem(${idx})">删除</button>`;
        dom.appendChild(div);
    })
}
window.delItem = function(idx){
    studyRecords.splice(idx,1);
    saveStudyLocal(studyRecords);renderList();renderChart();
}

function renderChart(){
    const raw = studyRecords;
    const pred = getStudyPredict(raw);
    const dates = raw.map(i=>i[0]);
    const predDates = pred.map(i=>i[0]);
    const allX = [...dates,...predDates];
    const candleData = raw.map(d=>[d[1],d[4],d[3],d[2]]);

    const option = {
        tooltip:{trigger:'axis',axisPointer:{type:'cross'}},
        legend:{data:['学情K线(掌握度)','模拟学习掌握趋势'],top:8},
        grid:{left:'7%',right:'5%',bottom:'14%'},
        xAxis:{type:'category',data:allX,axisLabel:{rotate:30}},
        yAxis:{type:'value',name:'知识掌握度(0‑100)',min:0,max:100},
        series:[
            {
                name:"学情K线(掌握度)",
                type:"candlestick",
                data:candleData,
                itemStyle:{color:'#ef4444',color0:'#16a34a',borderColor:'#ef4444',borderColor0:'#16a34a'}
            },
            {
                name:"模拟学习掌握趋势",
                type:"line",
                data:(()=>{
                    let arr = Array(raw.length).fill(null);
                    pred.forEach(p=>arr.push(p[1]));
                    return arr;
                })(),
                symbol:'circle',symbolSize:6,
                lineStyle:{color:'#f97316',type:'dashed',width:2},
                itemStyle:{color:'#f97316'}
            }
        ]
    }
    myChart.setOption(option);
}

//学情导入导出
document.getElementById("btnExportStudy").onclick = ()=>{
    const blob = new Blob([JSON.stringify(studyRecords,null,2)],{type:"application/json"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');a.href=url;a.download="finance_study_data.json";a.click();URL.revokeObjectURL(url);
}
document.getElementById("btnImportStudy").onclick = ()=>document.getElementById("fileImportStudy").click();
document.getElementById("fileImportStudy").onchange = function(e){
    const f = e.target.files[0];if(!f)return;
    const reader = new FileReader();
    reader.onload = ev=>{
        try{
            const arr = JSON.parse(ev.target.result);
            if(!Array.isArray(arr))throw 1;
            studyRecords=arr;saveStudyLocal(studyRecords);renderList();renderChart();alert("学情数据导入成功");
        }catch{alert("导入失败，JSON格式错误")}
    }
    reader.readAsText(f);
}

document.getElementById("btnAiAnalysis").onclick = ()=>{
    const reportDom = document.getElementById("aiStudyReport");
    reportDom.style.display="block";
    const resultText = OfflineAgent.analysisStudy(studyRecords, lastQuizFinalScore);
    reportDom.innerText = resultText;
}

// ==========题库部分 ==========
const baseQuizBank = [
