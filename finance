                <input class="input-text" id="askInput" placeholder="输入金融学问题，如：什么是MM理论？CAPM模型？">
                <button id="btnAsk">🧠离线智能体问答</button>
                <div class="qa-area" id="qaOutput">离线智能体就绪，请输入金融学课程问题。</div>
