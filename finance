document.getElementById("btnExportAllQuiz").onclick = ()=>{
    const blob = new Blob([JSON.stringify(totalQuizBank,null,2)],{type:"application/json"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href=url;
    a.download="finance_all_quiz_bank.json";
